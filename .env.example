# 국가법령정보센터 Open API 인증키 (https://open.law.go.kr 에서 무료 신청, 보통 이메일 ID)
LAW_OC=
# 선택: 근거 Q&A 답변 생성에 사용 (없으면 검색 결과 발췌만 보여줌)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 선택: 경기데이터드림 Open API 인증키 (https://data.gg.go.kr 회원가입 → 인증키 신청). 지구대·파출소, 학교 현황
GG_DATA_KEY=
GOOGLE_TRANSLATE_API_KEY=
# 선택: 열린국회정보 Open API 인증키 (https://open.assembly.go.kr 회원가입 → 인증키 발급). 교권 관련 국회 법률안
ASSEMBLY_KEY=
